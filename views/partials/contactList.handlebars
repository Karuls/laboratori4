{{#each contacts}}
    {{#if ../isUpdatePage}}
        <a href="/Update?id={{this.id}}" class="contact-btn">{{this.name}} - {{this.phone}}</a>
    {{else if ../isAddPage}}
        <button class="contact-btn" disabled style="opacity: 0.5; cursor: not-allowed;">{{this.name}} - {{this.phone}}</button>
    {{else}}
        <a href="/Update?id={{this.id}}" class="contact-btn">{{this.name}} - {{this.phone}}</a>
    {{/if}}
{{/each}}